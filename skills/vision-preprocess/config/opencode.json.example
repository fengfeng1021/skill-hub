{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "opencode-go": {
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "reasoning": true,
          "tool_call": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        }
      }
    },
    "gemini": {
      "options": {
        "baseURL": "https://aiapi.tw/v1beta",
        "apiKey": "這裡放你的 aiapi.tw API key（sk-...）"
      },
      "npm": "@ai-sdk/google",
      "models": {
        "gemini-3.5-flash-lite": {
          "name": "Gemini 3.5 Flash Lite",
          "tool_call": true,
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          }
        },
        "gemini-3.1-flash-lite": {
          "name": "Gemini 3.1 Flash Lite",
          "tool_call": true,
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          }
        },
        "gemini-3.1-flash-lite-preview": {
          "name": "Gemini 3.1 Flash Lite Preview",
          "tool_call": true,
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          }
        }
      }
    }
  }
}
