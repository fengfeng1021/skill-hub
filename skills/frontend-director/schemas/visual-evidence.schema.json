{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fengfeng1021.github.io/skill-hub/schemas/frontend-visual-evidence-v1.json",
  "title": "Frontend Director Signature Visual Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "surface", "reviewer", "signatureVisuals", "verdict", "issues"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "surface": { "type": "string", "minLength": 1 },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "id", "blind"],
      "properties": {
        "mode": { "enum": ["independent-agent", "human", "degraded-self-review"] },
        "id": { "type": "string", "minLength": 1 },
        "blind": { "type": "boolean" },
        "limitations": { "type": "string", "minLength": 20 }
      }
    },
    "signatureVisuals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "claim",
          "factual",
          "truthMode",
          "sources",
          "implementationFiles",
          "screenshots",
          "checks",
          "notes"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "claim": { "type": "string", "minLength": 1 },
          "factual": { "type": "boolean" },
          "truthMode": {
            "enum": ["sourced", "procedural-validated", "generated-illustration", "intentional-abstraction"]
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["uri", "license", "note"],
              "properties": {
                "uri": { "type": "string", "minLength": 1 },
                "license": { "type": "string", "minLength": 1 },
                "note": { "type": "string", "minLength": 1 }
              }
            }
          },
          "implementationFiles": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "screenshots": {
            "type": "object",
            "additionalProperties": false,
            "required": ["desktop", "mobile", "detail"],
            "properties": {
              "desktop": { "$ref": "#/$defs/screenshot" },
              "mobile": { "$ref": "#/$defs/screenshot" },
              "detail": { "$ref": "#/$defs/screenshot" }
            }
          },
          "checks": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "recognizableWithoutLabel",
              "entityDistinct",
              "notPlaceholder",
              "truthfulToClaim",
              "referenceMatch",
              "fullSizeCraft"
            ],
            "properties": {
              "recognizableWithoutLabel": { "const": true },
              "entityDistinct": { "const": true },
              "notPlaceholder": { "const": true },
              "truthfulToClaim": { "const": true },
              "referenceMatch": { "const": true },
              "fullSizeCraft": { "const": true }
            }
          },
          "notes": { "type": "string", "minLength": 1 }
        }
      }
    },
    "verdict": { "const": "pass" },
    "issues": { "type": "array", "maxItems": 0 }
  },
  "$defs": {
    "screenshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
